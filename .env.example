# Sanity — https://www.sanity.io/manage
VITE_PROJECT_ID=
VITE_DATASET=production
VITE_API_VERSION=v2023-10-01
# Server-only. Deliberately NOT VITE_-prefixed: that prefix marks a value as
# safe to ship to the browser, and this one must never be bundled.
SANITY_API_TOKEN=

# PostHog (optional locally)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

VITE_SITE_URL=http://localhost:5173
