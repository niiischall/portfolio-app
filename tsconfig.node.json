{
  "include": [
    "scripts/**/*.ts",
    "src/lib/sanity.queries.ts",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true
  }
}
